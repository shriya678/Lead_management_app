{
  "info": {
    "_postman_id": "lead-management-collection",
    "name": "Lead Management API",
    "description": "REST API for the Lead Management app — Digital Heroes Training Task.\n\n**How to use:**\n1. Import this collection into Postman.\n2. Confirm `baseUrl` collection variable points at your running API (default `http://localhost:5000`).\n3. Run **00. Setup > Login as Admin** first, then **Login as Member** — both save JWTs into collection variables that every other request reuses.\n4. Run the folders top-to-bottom, or click Runner and execute the whole collection.\n\nMost requests include a small test script that asserts the expected status code and captures IDs into collection variables (`leadId`, `adminId`, `memberId`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminEmail", "value": "admin@demo.com" },
    { "key": "adminPassword", "value": "Admin@123" },
    { "key": "memberEmail", "value": "member@demo.com" },
    { "key": "memberPassword", "value": "Member@123" },
    { "key": "adminToken", "value": "" },
    { "key": "memberToken", "value": "" },
    { "key": "adminRefreshToken", "value": "" },
    { "key": "memberRefreshToken", "value": "" },
    { "key": "adminId", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "leadId", "value": "" }
  ],
  "item": [
    {
      "name": "00. Setup",
      "description": "Run these two first. Each saves a JWT + user id into collection variables used everywhere else.",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "pm.test('Has accessToken', () => pm.expect(res.accessToken).to.be.a('string'));",
              "pm.test('Has refreshToken', () => pm.expect(res.refreshToken).to.be.a('string'));",
              "pm.test('User role is admin', () => pm.expect(res.user.role).to.eql('admin'));",
              "pm.collectionVariables.set('adminToken', res.accessToken);",
              "pm.collectionVariables.set('adminRefreshToken', res.refreshToken);",
              "pm.collectionVariables.set('adminId', res.user.id);"
            ]}
          }]
        },
        {
          "name": "Login as Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "pm.test('Has accessToken', () => pm.expect(res.accessToken).to.be.a('string'));",
              "pm.test('Has refreshToken', () => pm.expect(res.refreshToken).to.be.a('string'));",
              "pm.test('User role is member', () => pm.expect(res.user.role).to.eql('member'));",
              "pm.collectionVariables.set('memberToken', res.accessToken);",
              "pm.collectionVariables.set('memberRefreshToken', res.refreshToken);",
              "pm.collectionVariables.set('memberId', res.user.id);"
            ]}
          }]
        }
      ]
    },
