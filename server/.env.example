# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local Mongo: mongodb://127.0.0.1:27017/lead_management
# Atlas:       mongodb+srv://<user>:<pwd>@<cluster>/lead_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/lead_management

# --- CORS ---
# Origin of the React app that is allowed to call this API.
FRONTEND_URL=http://localhost:5173

# --- Auth ---
# Generate a strong random secret, e.g.:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
