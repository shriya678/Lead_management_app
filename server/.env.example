# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local Mongo: mongodb://127.0.0.1:27017/lead_management
# Atlas:       mongodb+srv://<user>:<pwd>@<cluster>/lead_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/lead_management

# --- CORS ---
# Origin of the React app that is allowed to call this API.
FRONTEND_URL=http://localhost:5173

# --- Auth ---
# Two independent secrets so a leaked access token cannot be used to forge refresh tokens
# and vice versa. Generate both, e.g.:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-DIFFERENT-long-random-string

# Access tokens are short-lived; clients refresh them silently via POST /api/auth/refresh
# using the longer-lived refresh token.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
