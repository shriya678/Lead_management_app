# Production env vars for the Render dashboard (Environment tab).
# DO NOT commit this file with real values.

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string (M0 free cluster).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/lead_management?retryWrites=true&w=majority

# Generate a strong random secret, e.g.:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRES_IN=7d

# CORS origin — the deployed frontend URL.
# Set AFTER Vercel gives you a URL, then Save + Rebuild + Deploy on Render.
FRONTEND_URL=https://your-app.vercel.app
